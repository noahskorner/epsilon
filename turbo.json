{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "dev": { "cache": false, "dependsOn": ["^dev"], "outputs": [] },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "build/**"]
    },
    "lint": { "cache": true },
    "test": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": []
    },
    "prisma:migrate:dev": {
      "cache": false,
      "outputs": []
    },
    "prisma:generate": {
      "cache": false,
      "outputs": []
    }
  }
}
